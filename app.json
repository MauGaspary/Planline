{
	"expo": {
		"name": "planline-mobile",
		"slug": "planline",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./app/assets/images/icon.png",
		"scheme": "myapp",
		"userInterfaceStyle": "automatic",
		"splash": {
			"image": "./app/assets/images/splash.png",
			"resizeMode": "contain",
			"backgroundColor": "#ffffff"
		},
		"assetBundlePatterns": ["**/*"],
		"ios": {
			"supportsTablet": true,
			"infoPlist": {
				"NSCameraUsageDescription": "Permitir que PlanLine acesse sua câmera.",
				"NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone"
			},
			"bundleIdentifier": "com.planline.planline",
			"googleServicesFile": "./GoogleService-Info.plist"
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./app/assets/images/adaptive-icon.png",
				"backgroundColor": "#ffffff"
			},
			"permissions": ["android.permission.CAMERA"],
			"package": "com.planline.planline",
			"googleServicesFile": "./google-services.json"
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./app/assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-barcode-scanner",
				{
					"cameraPermission": "Permitir que PlanLine acesse sua câmera."
				}
			],
			"@react-native-firebase/app",
			[
				"expo-build-properties",
				{
					"ios": {
						"useFrameworks": "static"
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {
				"origin": false
			},
			"eas": {
				"projectId": "fd618380-cce8-410c-b372-6e8198c40066"
			}
		},
		"owner": "planline",
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"updates": {
			"url": "https://u.expo.dev/fd618380-cce8-410c-b372-6e8198c40066"
		}
	}
}
