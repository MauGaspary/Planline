{
	"name": "backend",
	"version": "1.0.0",
	"type": "module",
	"description": "API created to support both the mobile and web frontends of the PlanLine application",
	"main": "src/index.ts",
	"scripts": {
		"build": "npx tsc",
		"start": "node dist/index.js",
		"dev": "concurrently \"npx tsc --watch\" \"nodemon -q dist/index.js\"",
		"preinstall": "npx only-allow yarn",
		"typecheck": "bash -c tsc",
		"lint": "eslint . --max-warnings=0 --ext .ts,.tsx",
		"format": "prettier --write .",
		"prepare": "husky install"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"./src/*.ts": [
			"yarn typecheck",
			"prettier --write",
			"yarn lint"
		],
		"yarn.lock": [
			"yarn-deduplicate"
		]
	},
	"repository": "https://tools.ages.pucrs.br/planline/backend.git",
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@prisma/client": "5.2.0",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"express": "^4.18.2",
		"firebase": "^10.4.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^17.7.1",
		"@commitlint/config-conventional": "^17.7.0",
		"@types/cors": "^2.8.14",
		"@types/express": "^4.17.17",
		"@types/node": "^20.5.3",
		"@typescript-eslint/eslint-plugin": "^6.4.1",
		"@typescript-eslint/parser": "^6.4.1",
		"concurrently": "^8.2.1",
		"eslint": "^8.45.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"husky": "^8.0.3",
		"lint-staged": "^14.0.1",
		"nodemon": "^3.0.1",
		"prettier": "^3.0.2",
		"prisma": "^5.2.0",
		"typescript": "^5.1.6",
		"yarn-deduplicate": "^6.0.1"
	}
}
