FROM node:18-alpine AS builder
WORKDIR /opt/app

ARG NODE_ENV=production
ENV NODE_ENV $NODE_ENV

ARG VITE_API_KEY
ARG VITE_AUTH_DOMAIN
ARG VITE_PROJECT_ID
ARG VITE_STORAGE_BUCKET
ARG VITE_MESSAGING_SENDER_ID
ARG VITE_APP_ID
ARG VITE_API_URL
ARG BACKEND_API_URL
ARG FIREBASE_API_KEY  
ARG FIREBASE_AUTH_DOMAIN 
ARG FIREBASE_DATABASE_URL 
ARG FIREBASE_PROJECT_ID 
ARG FIREBASE_STORAGE_BUCKET 
ARG FIREBASE_MESSAGING_SENDER_ID  
ARG FIREBASE_APP_ID 
ARG FIREBASE_MEASUREMENT_ID 


ENV FIREBASE_API_KEY $FIREBASE_API_KEY 
ENV FIREBASE_AUTH_DOMAIN $FIREBASE_AUTH_DOMAIN
ENV FIREBASE_DATABASE_URL $FIREBASE_DATABASE_URL
ENV FIREBASE_PROJECT_ID $FIREBASE_PROJECT_ID
ENV FIREBASE_STORAGE_BUCKET $FIREBASE_STORAGE_BUCKET
ENV FIREBASE_MESSAGING_SENDER_ID $FIREBASE_MESSAGING_SENDER_ID 
ENV FIREBASE_APP_ID $FIREBASE_APP_ID
ENV FIREBASE_MEASUREMENT_ID $FIREBASE_MEASUREMENT_ID
ENV VITE_API_KEY $VITE_API_KEY
ENV VITE_AUTH_DOMAIN $VITE_AUTH_DOMAIN  
ENV VITE_PROJECT_ID $VITE_PROJECT_ID  
ENV VITE_STORAGE_BUCKET $VITE_STORAGE_BUCKET  
ENV VITE_MESSAGING_SENDER_ID $VITE_MESSAGING_SENDER_ID  
ENV VITE_APP_ID $VITE_APP_ID  
ENV VITE_API_URL $VITE_API_URL
ENV BACKEND_API_URL $BACKEND_API_URL

COPY package.json ./
COPY yarn.lock ./
RUN yarn install --ignore-optional
COPY . .
RUN ls
RUN yarn build
RUN rm -rf node_modules && yarn install --production --ignore-scripts

FROM nginx:alpine AS deploy
WORKDIR /opt/app


ENV PATH /opt/node_app/node_modules/.bin:$PATH
COPY --chown=deploy --from=builder /opt/app /opt/app

RUN rm -rf /usr/share/nginx/html/*

COPY ./nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /opt/app/dist /usr/share/nginx/html
# Containers run nginx with global directives and daemon off
ENTRYPOINT ["nginx", "-g", "daemon off;"]

