# Build Stage
# ---
FROM node:18-alpine AS builder
WORKDIR /opt/app

# Copy necessary files
COPY package.json ./
COPY yarn.lock ./
RUN yarn install --ignore-optional
COPY . .
RUN yarn prisma generate
RUN yarn build
RUN rm -rf node_modules && yarn install --production --ignore-scripts
RUN yarn prisma generate

# Run Stage
# ---
FROM node:18-alpine AS deploy

COPY --chown=deploy --from=builder /opt/app /opt/app
WORKDIR /opt/app

# Define build arguments
ARG DATABASE_URL
ARG FIREBASE_API_KEY
ARG FIREBASE_APP_ID
ARG FIREBASE_AUTH_DOMAIN
ARG FIREBASE_DATABASE_URL
ARG FIREBASE_MEASUREMENT_ID
ARG FIREBASE_MESSAGING_SENDER_ID
ARG FIREBASE_PROJECT_ID
ARG FIREBASE_STORAGE_BUCKET
ARG PORT
ARG POSTGRES_PASSWORD
ARG POSTGRES_USER

ENV DATABASE_URL $DATABASE_URL
ENV FIREBASE_API_KEY $FIREBASE_API_KEY
ENV FIREBASE_APP_ID $FIREBASE_APP_ID
ENV FIREBASE_AUTH_DOMAIN $FIREBASE_AUTH_DOMAIN
ENV FIREBASE_DATABASE_URL $FIREBASE_DATABASE_URL
ENV FIREBASE_MEASUREMENT_ID $FIREBASE_MEASUREMENT_ID
ENV FIREBASE_MESSAGING_SENDER_ID $FIREBASE_MESSAGING_SENDER_ID
ENV FIREBASE_PROJECT_ID $FIREBASE_PROJECT_ID
ENV FIREBASE_STORAGE_BUCKET $FIREBASE_STORAGE_BUCKET
ENV PORT $PORT
ENV POSTGRES_PASSWORD $POSTGRES_PASSWORD
ENV POSTGRES_USER $POSTGRES_USER

# Set environment variables
ENV NODE_ENV production
ENV PATH /opt/node_app/node_modules/.bin:$PATH

# Expose the port
EXPOSE 3000

# Specify the default command to run
CMD ["dist/index.js"]
