// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum level {
  JUNIOR
  PLENO
  SENIOR
}

model User {
  id              String            @id @default(uuid())
  name            String            @db.VarChar(100)
  email           String            @db.VarChar(50)
  level           level             @default(JUNIOR)
  updated_at      DateTime          @updatedAt
  created_at      DateTime          @default(now())
  Squad           Squad[]
  Vote            Vote[]
}

model Squad {
  id                 String               @id @default(uuid())
  name               String               @db.VarChar(100)
  organization       Organization         @relation(fields: [organization_id], references: [id])
  organization_id    String
	users              User[]
	projects           Project[]
  updated_at         DateTime             @updatedAt
  created_at         DateTime             @default(now())
	
}

model Organization {
  id         String    @id @default(uuid())
  name       String    @db.VarChar(100)
  email      String    @db.VarChar(50)
	projects    Project[]
  squads      Squad[]
  updated_at DateTime  @updatedAt
  created_at DateTime  @default(now())
}

model Project {
  id                 String               @id @default(uuid())
  name               String               @db.VarChar(100)
  Organization       Organization         @relation(fields: [organization_id], references: [id])
	squads             Squad[]
  organization_id    String
  updated_at         DateTime             @updatedAt
  created_at         DateTime             @default(now())
}

model Sprint {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(100)
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())
}

model Story {
  id           String   @id @default(uuid())
  story_id     String   @db.VarChar(15) @unique
  name         String   @db.VarChar(100)
  final_points Int      @db.Integer
	tasks        Task[]
  updated_at   DateTime @updatedAt
  created_at   DateTime @default(now())
}

model Task {
  id         String   @id @default(uuid())
  task_id    String   @db.VarChar(15) @unique
  name       String   @db.VarChar(100)
  points     Int      @db.Integer
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())
  Vote       Vote[]
  story      Story   @relation(fields: [story_id], references: [id])
  story_id   String
}

model Vote {
  id      String @id @default(uuid())
  Task    Task   @relation(fields: [task_id], references: [id])
  task_id String
  User    User   @relation(fields: [user_id], references: [id])
  user_id String
  score   Int    @db.Integer
}
