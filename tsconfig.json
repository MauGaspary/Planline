{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"module": "ESNext",
		"moduleResolution": "Node",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"outDir": "dist"
	},
	"include": ["src/**/*"],
	"exclude": ["dist/**/*"]
}
